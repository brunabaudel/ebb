# Fastlane lanes for Codemagic CI (and optional local use).
# Requires App Store Connect API credentials — on Codemagic these come from the
# Team integration named "ebb" (APP_STORE_CONNECT_* env vars).

default_platform(:ios)

TEAM_ID = "3F274MB2RL"
BUNDLE_ID = "com.bcbs.ebb"
XCODE_PROJECT = "Ebb.xcodeproj"
SCHEME = "Ebb"
APP_STORE_PROFILE_NAME = "Ebb App Store CI"
ADHOC_PROFILE_NAME = "Ebb Ad Hoc CI"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def asc_env_present?
  %w[
    APP_STORE_CONNECT_KEY_IDENTIFIER
    APP_STORE_CONNECT_ISSUER_ID
    APP_STORE_CONNECT_PRIVATE_KEY
  ].all? { |name| ENV[name].to_s.strip != "" }
end

def asc_api_key
  unless asc_env_present?
    UI.user_error!(
      "Missing App Store Connect API credentials. " \
      "Add the Team integration named \"ebb\" in Codemagic " \
      "(see Ebb/CODEMAGIC_SETUP.md)."
    )
  end

  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_IDENTIFIER"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY"),
    duration: 1200,
    in_house: false
  )
end

# Existing Ruby CI scripts expect a .p8 file and APPSTORE_* env vars.
def write_api_key_for_ruby_scripts
  key_id = ENV.fetch("APP_STORE_CONNECT_KEY_IDENTIFIER")
  issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID")
  private_key = ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY")

  ENV["APPSTORE_API_KEY_ID"] = key_id
  ENV["APPSTORE_ISSUER_ID"] = issuer_id

  key_dir = File.expand_path("~/.appstoreconnect/private_keys")
  key_file = File.join(key_dir, "AuthKey_#{key_id}.p8")
  FileUtils.mkdir_p(key_dir)
  File.write(key_file, private_key)
  File.chmod(0o600, key_file)

  unless File.read(key_file).include?("BEGIN PRIVATE KEY")
    UI.user_error!("APP_STORE_CONNECT_PRIVATE_KEY is missing BEGIN PRIVATE KEY header")
  end
end

def resolve_simulator_destination
  sh("bash", File.expand_path("../ci/resolve_simulator_destination.sh", __dir__), log: false).strip
end

def ci_build_number
  ENV.fetch("BUILD_NUMBER") { UI.user_error!("BUILD_NUMBER is not set") }
end

def prepare_signing(api_key:, export_method:, profile_name:, adhoc: false)
  setup_ci if is_ci

  cert(
    api_key: api_key,
    team_id: TEAM_ID,
    development: false,
    force: false
  )

  sigh_options = {
    api_key: api_key,
    app_identifier: BUNDLE_ID,
    provisioning_name: profile_name,
    force: true
  }
  sigh_options[:adhoc] = true if adhoc

  sigh(**sigh_options)

  update_code_signing_settings(
    use_automatic_signing: false,
    path: XCODE_PROJECT,
    team_id: TEAM_ID,
    code_sign_identity: "Apple Distribution",
    profile_name: profile_name,
    bundle_identifier: BUNDLE_ID,
    targets: ["Ebb"]
  )

  export_options = {
    method: export_method,
    signingStyle: "manual",
    teamID: TEAM_ID,
    uploadSymbols: true,
    provisioningProfiles: {
      BUNDLE_ID => profile_name
    }
  }

  export_options
end

# ---------------------------------------------------------------------------
# Lanes
# ---------------------------------------------------------------------------

platform :ios do
  desc "Run unit tests on an available iOS Simulator (no signing)"
  lane :test do
    scan(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: "Debug",
      destination: resolve_simulator_destination,
      derived_data_path: "/tmp/DerivedData",
      clean: false,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Register bundle ID, sign, build, and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    write_api_key_for_ruby_scripts

    sh("ruby", File.expand_path("../ci/register_bundle_id.rb", __dir__))
    sh("ruby", File.expand_path("../ci/verify_app_store_connect_app.rb", __dir__))
    sh("ruby", File.expand_path("../ci/create_beta_group.rb", __dir__))

    export_options = prepare_signing(
      api_key: api_key,
      export_method: "app-store",
      profile_name: APP_STORE_PROFILE_NAME
    )

    increment_build_number(
      build_number: ci_build_number,
      xcodeproj: XCODE_PROJECT
    )

    ipa_path = build_app(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: export_options,
      output_directory: "./fastlane/output",
      output_name: "Ebb.ipa"
    )

    sh("ruby", File.expand_path("../ci/verify_release_entitlements.rb", __dir__), ipa_path)

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      groups: ["Ebb Internal"],
      notify_external_testers: false
    )
  end

  desc "Build a signed Ad Hoc IPA for direct device install"
  lane :adhoc do
    api_key = asc_api_key

    export_options = prepare_signing(
      api_key: api_key,
      export_method: "ad-hoc",
      profile_name: ADHOC_PROFILE_NAME,
      adhoc: true
    )

    increment_build_number(
      build_number: ci_build_number,
      xcodeproj: XCODE_PROJECT
    )

    build_app(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "ad-hoc",
      export_options: export_options,
      output_directory: "./fastlane/output",
      output_name: "Ebb-adhoc.ipa"
    )
  end
end
