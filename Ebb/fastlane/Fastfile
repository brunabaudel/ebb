# Fastlane lanes for Codemagic CI (and optional local use).
# Simulator tests need no signing. Device builds rely on certificates and
# provisioning profiles uploaded in Codemagic Code signing identities.

default_platform(:ios)

XCODE_PROJECT = "Ebb.xcodeproj"
SCHEME = "Ebb"

def resolve_simulator_destination
  sh("bash", File.expand_path("../ci/resolve_simulator_destination.sh", __dir__), log: false).strip
end

def ci_build_number
  ENV.fetch("BUILD_NUMBER") { UI.user_error!("BUILD_NUMBER is not set") }
end

platform :ios do
  desc "Run unit tests on an available iOS Simulator (no signing)"
  lane :test do
    scan(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: "Debug",
      destination: resolve_simulator_destination,
      derived_data_path: "/tmp/DerivedData",
      clean: false,
      xcargs: "CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Build a signed Ad Hoc IPA for direct device install"
  lane :adhoc do
    # Codemagic runs `xcode-project use-profiles` before this lane, which
    # applies the uploaded Distribution certificate and Ad Hoc profile.
    increment_build_number(
      build_number: ci_build_number,
      xcodeproj: XCODE_PROJECT
    )

    build_app(
      project: XCODE_PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "ad-hoc",
      output_directory: "./fastlane/output",
      output_name: "Ebb-adhoc.ipa"
    )
  end
end
